ARG LOOM_DOCKER_PREFIX=
FROM ${LOOM_DOCKER_PREFIX}golang:1.25.14-alpine AS build
ARG LOOM_GO_PROXY=https://proxy.golang.org,direct
ARG LOOM_ALPINE_MIRROR=
RUN if [ -n "$LOOM_ALPINE_MIRROR" ]; then \
      v=$(cut -d. -f1,2 /etc/alpine-release); \
      printf '%s/v%s/main\n%s/v%s/community\n' "$LOOM_ALPINE_MIRROR" "$v" "$LOOM_ALPINE_MIRROR" "$v" > /etc/apk/repositories; \
    fi \
 && apk add --no-cache ca-certificates curl git
WORKDIR /src
# Official upstream source, pinned independently of mutable tags or registries.
RUN curl --proto '=https' --tlsv1.2 -fsSL --retry 3 \
      https://codeload.github.com/minio/minio/tar.gz/7aac2a2c5b7c882e68c1ce017d8256be2feea27f -o /source.tar.gz \
 && echo '71794c2df26aad0cc99e8421c58b7aa2dd55969f979b0e7d1e931042e9fabcd6  /source.tar.gz' | sha256sum -c - \
 && tar -xzf /source.tar.gz --strip-components=1 -C /src
# The installer supplies the selected module proxy. Go still verifies go.sum
# and the public checksum database; integrity failures never bypass either.
ENV CGO_ENABLED=0 GOMAXPROCS=2 \
    GOPROXY="$LOOM_GO_PROXY" GOSUMDB=sum.golang.org
RUN go build -p 2 -mod=readonly -trimpath -buildvcs=false \
    -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2026-02-12T20:18:48Z -X github.com/minio/minio/cmd.ReleaseTag=DEVELOPMENT.2026-02-12T20-18-48Z -X github.com/minio/minio/cmd.CommitID=7aac2a2c5b7c882e68c1ce017d8256be2feea27f -X github.com/minio/minio/cmd.ShortCommitID=7aac2a2c5b7c' \
    -o /out/minio .

FROM ${LOOM_DOCKER_PREFIX}alpine:3.22
ARG LOOM_ALPINE_MIRROR=
RUN if [ -n "$LOOM_ALPINE_MIRROR" ]; then \
      v=$(cut -d. -f1,2 /etc/alpine-release); \
      printf '%s/v%s/main\n%s/v%s/community\n' "$LOOM_ALPINE_MIRROR" "$v" "$LOOM_ALPINE_MIRROR" "$v" > /etc/apk/repositories; \
    fi \
 && apk add --no-cache ca-certificates \
 && addgroup -g 1000 minio && adduser -D -u 1000 -G minio minio \
 && mkdir -p /data && chown 1000:1000 /data
ENV HOME=/home/minio
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /src/LICENSE /src/NOTICE /usr/share/licenses/minio/
COPY --from=build /source.tar.gz /usr/share/minio-source/source.tar.gz
LABEL org.opencontainers.image.source=https://github.com/minio/minio \
      org.opencontainers.image.revision=7aac2a2c5b7c882e68c1ce017d8256be2feea27f \
      org.opencontainers.image.licenses=AGPL-3.0-or-later
USER 1000:1000
VOLUME ["/data"]
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
