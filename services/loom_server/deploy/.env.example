# Sample credentials below deliberately fail production startup. Use the verified installer
# to generate independent random values; never deploy this file unchanged.
# Copy to .env or run a platform production setup script to generate it.
LOOM_MODE=production
LOOM_HOST=0.0.0.0
LOOM_PORT=7483
LOOM_HOST_PORT=7483
LOOM_PROXY_MODE=caddy
LOOM_PUBLIC_DOMAIN=chat.example.org
LOOM_PUBLIC_BASE_URL=https://chat.example.org
LOOM_OPERATOR_NAME=Example operator
LOOM_NETWORK_JURISDICTION=Example jurisdiction
LOOM_REGISTRATION_POLICY=approval
LOOM_FEDERATION_MODE=disabled
# Attachment ceiling includes the 28-byte encryption envelope. Restart after changes.
LOOM_MAX_ATTACHMENT_BYTES=104857600
LOOM_MAX_REQUEST_BYTES=1048576
# Opt in to public process-memory metrics; host/disk/network details are never published.
LOOM_PUBLIC_RESOURCE_METRICS=false
LOOM_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# 1:1 WebRTC calling is opt-in. Production validation refuses to enable calls
# without authenticated TURN. LOOM_TURN_SHARED_SECRET must match the coturn
# REST auth shared secret and must never be committed with a real value.
LOOM_CALLS_ENABLED=false
LOOM_VOICE_CALLS_ENABLED=true
LOOM_VIDEO_CALLS_ENABLED=true
LOOM_STUN_URLS=stun:turn.example.org:3478
LOOM_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:5349?transport=tcp
# LOOM_TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
LOOM_TURN_CREDENTIAL_TTL_SECONDS=600

# Optional public funding links shown on the Node landing page.
# Format: Label|https://url;Another label|https://url
# Only HTTPS links are rendered. Leave empty until official donation destinations are ready.
LOOM_DONATION_LINKS=

# PostgreSQL is included in docker-compose.production.yml.
POSTGRES_PASSWORD=replace-with-a-strong-random-password
LOOM_DATABASE_URL=postgres://loom:replace-with-a-strong-random-password@postgres:5432/loom

# MinIO is included as the default S3-compatible attachment store.
LOOM_S3_ENDPOINT=http://minio:9000
LOOM_S3_REGION=us-east-1
LOOM_S3_BUCKET=loom-attachments
LOOM_S3_ACCESS_KEY_ID=replace-with-a-random-access-key
LOOM_S3_SECRET_ACCESS_KEY=replace-with-a-strong-random-secret
LOOM_S3_FORCE_PATH_STYLE=true



# Optional comma-separated proxy CIDRs. Empty trusts no forwarded headers.
# Configure only the actual proxy addresses; never an entire public/tenant network.
LOOM_TRUSTED_PROXY_CIDRS=

# Non-delivered federation queue ceilings; saturation rejects new work for retry.
LOOM_FEDERATION_QUEUE_ITEMS=8192
LOOM_FEDERATION_QUEUE_BYTES=268435456
LOOM_FEDERATION_PEER_QUEUE_ITEMS=1024
LOOM_FEDERATION_PEER_QUEUE_BYTES=67108864
